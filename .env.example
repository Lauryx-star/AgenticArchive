# Copy to .env beside compose.yaml. Start with: docker compose up -d --build
# Existing .env: transfer desired settings instead of overwriting it.
# .env and secrets/ are ignored by Git. Keep keys out of this template.

# Archive directory on the Docker host; must already exist.
ARCHIVE_PATH=./archive
# Local access by default. Use a LAN address or 0.0.0.0 for network access.
ARCHIVE_HOST_BIND=127.0.0.1
ARCHIVE_PORT=8080
# true behind an HTTPS reverse proxy; false for local HTTP.
AUTH_SECURE_COOKIE=false

# Persistent database/index/user data. Each archive needs its own volume.
# For an existing deployment, use its EXACT volume name to retain all data.
ARCHIVE_DATA_VOLUME=agenticarchive-data
# true: reuse an existing volume and keep it external to Compose.
# false: Compose creates/manages the volume. Do not use down -v to stop it.
ARCHIVE_DATA_EXTERNAL=false

# Secret folder on the Docker host. Create it before starting Compose.
# Always required: agent-service-key.txt (32+ random characters).
# OpenAI only: openai-api-key.txt (raw key, without OPENAI_API_KEY=).
# Each container mounts only its needed secret files. On Linux, ensure
# UID 10001 can read the files (appropriate ownership or ACLs).
SECRETS_PATH=./secrets

# The optional agent is selected below through COMPOSE_PROFILES.
# Archive -> agent. Set empty as well when disabling Chat.
AGENT_URL=http://archive-agent:8081
# Agent -> archive; change for an archive on another host (HTTPS/VPN).
ARCHIVE_MCP_URL=http://agenticarchive:8080/mcp

# Local Ollama on macOS. Install/run Ollama on the Mac (not a container).
# Download model: ollama pull qwen3:8b
LLM_PROVIDER=ollama
OPENAI_MODEL=qwen3:8b
OPENAI_API_URL=http://host.docker.internal:11434/v1/responses
# Automatically start the selected provider; empty = archive only.
# Choose ONE profile: openai or ollama. Do not enable both at once.
COMPOSE_PROFILES=${LLM_PROVIDER}
# No OpenAI key file required. Use a local model, not a -cloud model tag.

# OpenAI alternative: replace the three active model settings above with:
# LLM_PROVIDER=openai
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_API_URL=https://api.openai.com/v1/responses
# Save the API key in secrets/openai-api-key.txt (or your SECRETS_PATH).

# OPENAI_MODEL and OPENAI_API_URL may be empty to use provider defaults.
# The URL is the COMPLETE Responses endpoint, not just /v1.
# Other authenticated compatible servers: LLM_PROVIDER=openai, their HTTPS URL,
# their model name and their key in openai-api-key.txt.
# Requires Responses API + function calls + tool-result replay;
# Chat Completions compatibility alone is insufficient.
# Only use a trusted endpoint: it receives questions and requested archive text.

# Agent listens internally on port 8081; no public host port is published.
# Container key paths and resource limits are defined in compose.yaml.
